# ==========================================
# MILLIONAIRE SHARKS TELEGRAM COMMUNITY BOT
# ==========================================

# 1. Telegram Configuration
# Obtain your bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here
# The ID of your Telegram community group/supergroup (usually starts with -100)
COMMUNITY_CHAT_ID=-1001234567890
# Comma-separated list of Telegram User IDs allowed to execute admin commands
ADMIN_USER_IDS=123456789,987654321

# 2. Database Configuration
# Default SQLite local database (can be swapped to PostgreSQL: postgresql://user:pass@host:5432/db)
DATABASE_URL="file:./data/millionaire_sharks.db"

# 3. Buy Bot Configuration
# Minimum USD value to trigger group purchase announcement (Default: 10)
BUY_BOT_MIN_USD=10
# Poll interval in milliseconds for DEX / Blockchain checks (e.g. 10000 = 10s)
BUY_BOT_POLL_INTERVAL_MS=10000

# 4. Token & Blockchain Configuration (Configurable for Robinhood Chain or any EVM / Chain)
TOKEN_NAME="Millionaire Sharks"
TOKEN_SYMBOL="MSC"
# Token contract address on the target blockchain
TOKEN_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
# Primary DEX pair address (e.g. Uniswap pool on Robinhood Chain)
DEX_PAIR_ADDRESS="0x0000000000000000000000000000000000000000"
TOKEN_DECIMALS=18
CHAIN_ID=4663
CHAIN_NAME="Robinhood"
CHAIN_RPC_URL="https://rpc.mainnet.chain.robinhood.com"
CHAIN_EXPLORER_URL="https://robinhoodchain.blockscout.com"

# 5. External Links & Community Info
DEX_CHART_URL="https://dexscreener.com/robinhood"
DEX_TRADE_URL="https://robinhood.com/crypto"
OFFICIAL_WEBSITE="https://millionairesharks.com"
OFFICIAL_X="https://x.com/MillionaireSharks"

# 6. Centralized Feature Flags (Day One: Buy Bot & Welcome Bot ONLY)
FEATURE_BUY_BOT=true
FEATURE_WELCOME_BOT=true
FEATURE_DAILY_SHARK=false
FEATURE_CASINO=false
FEATURE_LEADERBOARD=false
FEATURE_GIVEAWAYS=false

# 7. Shark Points & Casino Game Rules
DAILY_MIN_POINTS=50
DAILY_MAX_POINTS=1000
CASINO_MIN_WAGER=10
CASINO_MAX_WAGER=50000
