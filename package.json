  "version": "1.0.0",
  "description": "Millionaire Sharks All-in-One Telegram Community Bot",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "features:status": "tsx scripts/statusFeatures.ts",
    "features:enable-all": "tsx scripts/activateAllFeatures.ts",
    "features:reset-day-one": "tsx scripts/resetToDayOne.ts",
    "simulate:buy": "tsx scripts/simulateBuy.ts",
    "simulate:welcome": "tsx scripts/simulateWelcome.ts"
  },
  "keywords": [
    "telegram-bot",
    "crypto",
