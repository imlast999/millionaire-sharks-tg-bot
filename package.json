  "license": "ISC",
  "dependencies": {
    "@grammyjs/ratelimiter": "^1.2.0",
    "@grammyjs/runner": "^2.0.3",
    "@prisma/client": "^6.4.1",
    "axios": "^1.7.9",
    "bignumber.js": "^9.1.2",
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0",
    "viem": "^2.23.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
